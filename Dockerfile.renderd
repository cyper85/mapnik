FROM ubuntu:26.04

ENV TZ=Etc/UTC
ARG DEBIAN_FRONTEND=noninteractive
ENV POSTGRES_DB=postgres
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=""
ENV POSTGRES_HOST=localhost
ENV POSTGRES_PORT=5432
ENV THREADS=4
# System-User, den das Debian/Ubuntu-Paket renderd anlegt
ENV RENDERD_USER=_renderd

RUN apt-get --quiet update && \
    apt-get --yes --quiet install renderd openstreetmap-carto python3-lxml python3-psycopg2 python3-requests python3-yaml fonts-noto-cjk fonts-noto-hinted fonts-noto-unhinted fonts-hanazono fonts-unifont && \
    rm --recursive --force /var/lib/apt/lists/*

# Configure renderd: Mapnik-Plugin-Verzeichnis ermitteln, Stylesheet prüfen
COPY renderd.conf /etc/renderd.conf
RUN plugins="$(find /usr/lib -type d -path '*/mapnik/*/input' | head --lines=1)" && \
    test -n "$plugins" && \
    sed --in-place "s#^plugins_dir=.*\$#plugins_dir=${plugins}#" /etc/renderd.conf && \
    test -f "$(sed --quiet 's/^XML=//p' /etc/renderd.conf)" && \
    id "$RENDERD_USER" && \
    mkdir --parents /run/renderd /var/cache/renderd/tiles && \
    chown "$RENDERD_USER": /run/renderd /var/cache/renderd/tiles

COPY editmapnikconfig.py /usr/local/bin/editmapnikconfig.py
COPY renderd-entrypoint.sh /usr/local/bin/renderd-entrypoint.sh
RUN chmod a+x /usr/local/bin/editmapnikconfig.py /usr/local/bin/renderd-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/renderd-entrypoint.sh"]
